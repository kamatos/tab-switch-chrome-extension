{
  "manifest_version": 3,
  "name": "Tab Switcher",
  "version": "1.0.0",
  "description": "Switch between the two most recent tabs using Alt+Q (Option+Q on Mac)",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "commands": {
    "switch-tabs": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Switch between the two most recent tabs"
    },
    "switch-windows": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Move active tab to another window"
    },
    "duplicate-tab": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Duplicate active tab"
    }
  }
}
